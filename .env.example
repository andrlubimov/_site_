# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# Domain used by the deploy script to generate the nginx config
DOMAIN=example.com

# Сайт конвенции — тот же сервер, свой домен (приложение convention); несколько — через запятую.
# deploy.sh пишет их в server_name nginx; Django сам добавляет их в ALLOWED_HOSTS.
# До открытия — временный домен для наполнения: CONVENTION_DOMAIN=convent.ska17.online
CONVENTION_DOMAIN=convent.grudnichkovoe-plavanie.ru
# Настоящий домен: только на нём сайт конвенции открыт поисковикам, на остальных — noindex
CONVENTION_PUBLIC_HOST=convent.grudnichkovoe-plavanie.ru
# Основной сайт — для ссылок с сайта конвенции
MAIN_SITE_URL=https://www.grudnichkovoe-plavanie.ru/

# Git repository URL (used by deploy.sh to clone the project)
REPO_URL=https://github.com/andrlubimov/swimming_association.git

# Root directory where the site will be deployed on the server
DEPLOY_DIR=/var/www/swimming_association
VENV_DIR=/var/www/swimming_association/.venv
SYSTEMD_SERVICE=swimming_association
NGINX_SERVICE=nginx

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=swimming_association
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
# Set USE_S3=true to serve static and media files via MinIO/S3.
# Set USE_S3=false to serve them through nginx from the local filesystem.
USE_S3=false
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET_NAME=swimming-association
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
